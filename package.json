{
  "name": "plotagents",
  "version": "0.8.0",
  "description": "The chart protocol for AI agents: one JSON spec in, a finished accessible SVG out. Bars, lines, Gantt charts, treemaps, sankeys, maps from any GeoJSON/TopoJSON, networks and seaborn-style plots. Zero dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./index.d.ts",
      "default": "./src/core.js"
    },
    "./maps": {
      "types": "./index.d.ts",
      "default": "./src/maps.js"
    },
    "./table": {
      "types": "./index.d.ts",
      "default": "./src/table-entry.js"
    },
    "./types/*": {
      "types": "./index.d.ts",
      "default": "./src/types/*.js"
    },
    "./schema.json": "./schema.json",
    "./browser": "./dist/plotagents.js",
    "./browser/geo": "./dist/plotagents-geo.js",
    "./geo/chile": "./src/geo/chile.js",
    "./geo/world": "./src/geo/world.js",
    "./geo/usa": "./src/geo/usa.js"
  },
  "bin": {
    "plotagents": "bin/plotagents.js"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "skills",
    "bin",
    "index.d.ts",
    "schema.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/bundle.js",
    "bench": "node scripts/bench.js",
    "prepublishOnly": "node scripts/bundle.js && node --test test/*.test.js",
    "examples": "node examples/build.js",
    "site": "node scripts/build-site.js && node scripts/build-site.js --lang es",
    "schema": "node -e \"import('./src/index.js').then(m=>process.stdout.write(JSON.stringify(m.schema,null,2)))\" > schema.json"
  },
  "keywords": [
    "chart",
    "plot",
    "svg",
    "dataviz",
    "visualization",
    "treemap",
    "sankey",
    "seaborn",
    "regplot",
    "violin",
    "radar",
    "sunburst",
    "ai",
    "agents",
    "llm",
    "tool-use",
    "gantt",
    "timeline",
    "geojson",
    "topojson",
    "choropleth",
    "map"
  ],
  "author": "Carlos Navarrete <cnavarreteliz@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosnavarreteliz/plotagents.git"
  },
  "homepage": "https://carlosnavarrete.cl/plotagents/",
  "bugs": {
    "url": "https://github.com/carlosnavarreteliz/plotagents/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./src/index.js",
    "./src/core.js",
    "./src/maps.js",
    "./src/table-entry.js",
    "./src/types/*.js",
    "./src/geo/*.js",
    "./dist/*.js"
  ]
}
