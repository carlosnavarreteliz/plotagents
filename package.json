{
  "name": "plotagents",
  "version": "0.4.0",
  "description": "Beautiful charts from one JSON spec, built for AI agents: bars, lines, multi-level treemaps, sunbursts, sankeys and seaborn-style plots (regplot, hist, kde, box, violin…). Accessible SVG, time sliders, JSON themes, zero dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./schema.json": "./schema.json",
    "./browser": "./dist/plotagents.js",
    "./browser/geo": "./dist/plotagents-geo.js",
    "./geo/chile": "./src/geo/chile.js",
    "./geo/world": "./src/geo/world.js"
  },
  "bin": {
    "plotagents": "./bin/plotagents.js"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "bin",
    "index.d.ts",
    "schema.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/bundle.js",
    "bench": "node scripts/bench.js",
    "prepublishOnly": "node scripts/bundle.js && node --test test/*.test.js",
    "examples": "node examples/build.js",
    "schema": "node -e \"import('./src/index.js').then(m=>process.stdout.write(JSON.stringify(m.schema,null,2)))\" > schema.json"
  },
  "keywords": [
    "chart",
    "plot",
    "svg",
    "dataviz",
    "visualization",
    "treemap",
    "sankey",
    "seaborn",
    "regplot",
    "violin",
    "radar",
    "sunburst",
    "ai",
    "agents",
    "llm",
    "tool-use"
  ],
  "author": "Carlos Navarrete <cnavarreteliz@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
